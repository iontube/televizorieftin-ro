---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import products from '../../data/oferte.json';

export function getStaticPaths({ paginate }) {
  const sorted = [...products].sort((a, b) => a.price - b.price);   // cheapest first
  return paginate(sorted, { pageSize: 48 });
}

const { page } = Astro.props;
const money = (n) => Number(n).toLocaleString('ro-RO', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' lei';
const total = products.length;
const pageMod = page.data.reduce((m, p) => (p.modified && p.modified > m ? p.modified : m), '2026-04-01');
const brandList = Object.values(products.reduce((a, p) => { if (p.brandSlug) { (a[p.brandSlug] ||= { n: p.brand, s: p.brandSlug, c: 0 }).c++; } return a; }, {})).filter((b) => b.c >= 4).sort((a, b) => b.c - a.c);
const merchList = Object.values(products.reduce((a, p) => { if (p.merchantSlug) { (a[p.merchantSlug] ||= { n: p.merchantName, s: p.merchantSlug, c: 0 }).c++; } return a; }, {})).sort((a, b) => b.c - a.c);
const title = page.currentPage === 1
  ? `Televizoare ieftine: ${total} oferte sub 1500 lei ${new Date().getFullYear()} | televizorieftin.ro`
  : `Televizoare ieftine – pagina ${page.currentPage} din ${page.lastPage} | televizorieftin.ro`;
const desc = `Toate televizoarele ieftine din magazinele partenere: ${total} de modele LED, QLED, HD, Full HD și 4K sub 1500 lei, cu prețuri actualizate.${page.currentPage > 1 ? ` Pagina ${page.currentPage}.` : ''}`;
---
<Layout title={title} description={desc} modified={pageMod}>
  <Nav />
  <section class="po-sec">
    <div class="wrap">
      <nav class="crumb"><a href="/">Acasă</a> › <span>Oferte televizoare ieftine</span></nav>
      <span class="tag">Oferte</span>
      <h1>Televizoare ieftine sub 1500 lei</h1>
      <p class="sec-sub"><strong>{total}</strong> de televizoare ieftine din magazinele partenere — LED, QLED, HD, Full HD și 4K, de la 22&quot; la 43&quot;, cu prețuri actualizate periodic. Pagina {page.currentPage} din {page.lastPage}.</p>

      <div class="grid">
        {page.data.map((p) => (
          <article class="card">
            {p.oldPrice && <span class="card__badge card__badge--top">-{Math.round((1 - p.price / p.oldPrice) * 100)}%</span>}
            <a class="card__img" href={`/tv/${p.slug}/`} aria-label={p.name}><img src={p.img} alt={p.name} width="400" height="300" loading="lazy" decoding="async" /></a>
            <div class="card__body">
              <a href={`/tv/${p.slug}/`}><h3 class="card__name">{p.name}</h3></a>
              <div class="card__specs">{Object.values(p.specs).slice(1, 4).map((v) => <span class="card__spec">{v}</span>)}</div>
              <div class="card__price-row"><span class="card__price">{money(p.price)}</span>{p.oldPrice && <s>{money(p.oldPrice)}</s>}</div>
            </div>
            <div class="card__actions"><a href={`/tv/${p.slug}/`} class="card__buy">Vezi detalii</a></div>
          </article>
        ))}
      </div>

      <nav class="pager" aria-label="Paginare">
        {page.url.prev ? <a class="pg" href={page.url.prev}>← Anterioarele</a> : <span class="pg pg--off">← Anterioarele</span>}
        <span class="pg-now">Pagina {page.currentPage} / {page.lastPage}</span>
        {page.url.next ? <a class="pg" href={page.url.next}>Următoarele →</a> : <span class="pg pg--off">Următoarele →</span>}
      </nav>

      <div class="ilink">
        <h2>Televizoare ieftine după brand</h2>
        <div class="ilink__row">{brandList.map((b) => <a class="pg" href={`/brand/${b.s}/`}>{b.n} <span>({b.c})</span></a>)}</div>
      </div>
      <div class="ilink">
        <h2>Televizoare ieftine după magazin</h2>
        <div class="ilink__row">{merchList.map((m) => <a class="pg" href={`/magazin/${m.s}/`}>{m.n} <span>({m.c})</span></a>)}</div>
      </div>
    </div>
  </section>
  <Footer />
</Layout>
